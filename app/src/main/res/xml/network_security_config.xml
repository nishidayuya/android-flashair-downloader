<?xml version="1.0" encoding="utf-8"?>
<!--
  FlashAir speaks plain HTTP only, and Android forbids that by default.

  docs/design.md 3.2 left the choice to Phase 5, once the host became a setting:
  a build-time allowlist cannot cover a card the user reconfigured to another
  address, and an app that refuses to talk to the card the user pointed it at is
  worse than one that allows cleartext. So cleartext is allowed, and the exposure
  is kept small by the app itself:

  - every request goes through the OkHttp client bound to the card's Wi-Fi
    network, so it cannot leave that link (see FlashAirHttpClientFactory)
  - the app makes no other network requests at all, to anywhere

  The card's own names and factory address are listed explicitly so that the
  intent stays readable, and so that a future release can go back to an
  allowlist by flipping base-config alone.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Deliberate, see above: the card has no HTTPS and its address is a setting. -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">flashair</domain>
        <domain includeSubdomains="true">flashair.local</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
    </domain-config>
</network-security-config>
